# WMS - uploaded files are served, never executed.
Options -Indexes -ExecCGI
AddHandler cgi-script .php .phtml .php3 .php4 .php5 .php7 .php8 .pl .py .jsp .asp .sh .cgi
php_flag engine off

<FilesMatch "\.(php|phtml|php[3-8]|pl|py|jsp|asp|sh|cgi|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
